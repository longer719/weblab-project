{
  "data": {
    "data_dir": "data/processed",
    "batch_size": 64,
    "train_split": 0.7,
    "val_split": 0.1,
    "test_split": 0.2,
    "num_workers": 16
  },
  "model": {
    "backbone": "resnet101",
    "num_classes": 38,
    "pretrained": true,
    "dropout_rate": 0.4,
    "in_channels": 3
  },
  "train": {
    "epochs": 100,
    "lr": 0.0001,
    "optimizer": "AdamW",
    "scheduler": "OneCycleLR",
    "weight_decay": 0.01,
    "mixed_precision": true,
    "seed": 42,
    "warmup_epochs": 5,
    "save_interval": 5,
    "early_stopping": {
      "patience": 15,
      "delta": 0.001,
      "mode": "max",
      "monitor": "val_acc"
    },
    "device": "cuda"
  },
  "experiment_name": "plant_classifier_v03_full_dataset"
}