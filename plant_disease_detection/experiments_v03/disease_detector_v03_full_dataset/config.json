{
  "data": {
    "data_dir": "data/processed",
    "batch_size": 8,
    "train_split": 0.7,
    "val_split": 0.1,
    "test_split": 0.2,
    "num_workers": 16
  },
  "model": {
    "backbone": "resnet50",
    "num_classes": 38,
    "pretrained": true,
    "min_size": 800,
    "max_size": 1333,
    "compute_anchors": false,
    "box_score_thresh": 0.3,
    "box_nms_thresh": 0.45,
    "rpn_nms_thresh": 0.7
  },
  "train": {
    "epochs": 50,
    "lr": 0.0005,
    "optimizer": "AdamW",
    "scheduler": "CosineAnnealingLR",
    "weight_decay": 0.0005,
    "mixed_precision": true,
    "grad_accumulation_steps": 2,
    "seed": 42,
    "warmup_epochs": 3,
    "save_interval": 5,
    "vis_samples": 10,
    "early_stopping": {
      "patience": 10,
      "delta": 0.001,
      "mode": "max",
      "monitor": "mAP"
    },
    "device": "cuda"
  },
  "experiment_name": "disease_detector_v03_full_dataset"
}